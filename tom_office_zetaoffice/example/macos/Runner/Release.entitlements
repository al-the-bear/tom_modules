<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Unsandboxed like tom_forge_app (TD-25): the example opens documents
	     anywhere, keeps ZetaOffice in the user's cache folder and serves both
	     to the webview from a local server, which the App Sandbox blocks. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
